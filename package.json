{
  "name": "designon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:furniture": "node scripts/build-furniture-catalog.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:fast": "playwright test",
    "preview": "vite preview",
    "verify:worker": "cd workers/concept-render && npx tsc --noEmit && npx vitest run",
    "verify": "npm run lint && npm run build && npm test && npm run verify:worker && npm run test:e2e:fast",
    "deploy:pages": "npm run build && workers/concept-render/node_modules/.bin/wrangler pages deploy dist --project-name=luma-house --branch=main"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "suncalc": "2.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
