/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: https://geocoding-api.open-meteo.com https://luma-concept-render.drnon.workers.dev; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vite writes content-hashed filenames, so a file under this path can never
# change under the same name. Caching it for a year is safe, and it stops
# every release from re-downloading the whole app for a returning visitor.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand artwork keeps stable names, so it is revalidated often enough to
# pick up a change without costing a full download.
/brand/*
  Cache-Control: public, max-age=3600, must-revalidate

# The offline worker itself must never be served stale: a corrected shell
# that the browser never re-reads is a shell that never gets corrected.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
